{
  "info": {
    "_postman_id": "fc39e20c-21d1-44c2-abe1-9771b39af721",
    "name": "MinQuant Jobs API",
    "description": "MinQuant 进程内 Jobs HTTP API。服务端监听 0.0.0.0:5050；Postman 同机访问使用 localhost，异机访问时把 baseUrl 改为服务器真实 IP。创建 Job 后会自动把返回的 job_id 保存到 Collection 变量 jobId。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "检查 API 进程及 release identity。"
      },
      "response": []
    },
    {
      "name": "Create Jobs",
      "item": [
        {
          "name": "Create Data Standard Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.jobs?.[0]?.job_id) {",
                  "    pm.collectionVariables.set(\"jobId\", body.jobs[0].job_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"data-standard\",\n  \"start\": \"2026-08-20\",\n  \"end\": \"2026-08-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs"
              ]
            }
          },
          "response": []
        },
